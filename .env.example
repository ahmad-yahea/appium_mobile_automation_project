# Copy to .env and fill in. .env is git-ignored; never commit real values.
# Resolution order for every key: -DKEY=... > process environment > .env

# --- App under test -------------------------------------------------------
# Path to the build to install (the app itself is not part of this repo).
APP_APK_PATH=src/test/resources/app-staging-release.apk
APP_IOS_PATH=src/test/resources/app-staging-release.app
# Android package id; only used for the troubleshooting hints in scripts/run-tests.sh
APP_PACKAGE=com.example.myapp

# --- Devices --------------------------------------------------------------
PLATFORM=android
# Comma-separated emulator serials (one per parallel fork)
ANDROID_DEVICES=emulator-5554
IOS_DEVICE="iPhone 15"
# Only if Appium isn't on PATH: absolute path to appium/build/lib/main.js
APPIUM_MAIN_JS=

# --- Test account data ----------------------------------------------------
# Generated emails look like <LOCAL_PART>+<timestamp>@<DOMAIN>
TEST_EMAIL_LOCAL_PART=qa.user
TEST_EMAIL_DOMAIN=example.com
TEST_PASSWORD=ChangeMe123!

# --- Postman CLI (journey tests only) --------------------------------------
# Used by `postman login --with-api-key "$POSTMAN_API_KEY"`
POSTMAN_API_KEY=
POSTMAN_COLLECTION_ID=
POSTMAN_ENVIRONMENT_ID=
POSTMAN_INTEGRATION_ID=

# --- CI only (set as GitHub Actions secrets, not needed locally) ----------
# SLACK_WEBHOOK_URL=
# APP_APK_URL=
